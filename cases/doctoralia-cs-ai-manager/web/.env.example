# Copy to .env.local and fill in. .env.local is git-ignored; the key never reaches the browser.
ANTHROPIC_API_KEY=
# Fast model: message rewrite, explain, briefing
CS_AI_MODEL_FAST=claude-haiku-4-5-20251001
# Deep model: doctor analysis, ask
CS_AI_MODEL_DEEP=claude-sonnet-5-5
# 1 = never call the model; every AI surface shows its deterministic fallback
CS_AI_DISABLED=
# 1 = canned outputs per task, for tests and a no-key demo
CS_AI_MOCK=
# snapshot = the bundle's extract date; real = today's date
CS_CLOCK=snapshot
# where the outcome log, the AI ledger, settings and the AI cache live (default: ../out)
CS_OUT_DIR=
# ElevenLabs text to speech ("Escuchar" on Tu día / Qué pasó esta semana). Optional: no key, no button
ELEVENLABS_API_KEY=
# default: "Ana Sofía – Conversational" (neutral Mexican Spanish). A Voice Library voice may need
# "Add to my voices" in ElevenLabs before the API can use it
ELEVENLABS_VOICE_ID=ewn5JTa3lNPY8QVuZJi6
ELEVENLABS_MODEL=eleven_multilingual_v2
